# Staging reverse proxy. One hostname serves both surfaces:
#   /api/*, /health  -> the FastAPI service
#   everything else  -> the Next.js app
#
# SITE_ADDRESS comes from the environment (see docker-compose.staging.yml) so the
# hostname can change without editing this file (mshwarlb.com in production).
# Caddy obtains and renews the certificates automatically, including the one for
# www.<SITE_ADDRESS>, which only redirects to the bare domain so cookies and the
# cross-site request guard (PUBLIC_WEB_ORIGIN) always see one origin.
#
# Security plan items handled here:
#   SEC-13  the API's interactive docs are not routed (the API also turns them off).
#   SEC-14  secret links (calendar feeds, reset, verification, unsubscribe and share
#           tokens) and credentials never reach the access log.
#   SEC-15  request bodies are capped before they reach the app; slow clients time out.
#   SEC-17  TLS 1.2 and 1.3 only; HSTS on every response, the API's included.
{
	servers {
		protocols h1 h2 h3
		timeouts {
			read_header 10s
			read_body 60s
			write 60s
			idle 2m
		}
	}
}

(hardening) {
	tls {
		protocols tls1.2 tls1.3
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
		-X-Powered-By
	}
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri regexp "(/feeds/)[^/?#]+|([?&](?:token|code|key|t)=)[^&#]*" "${1}${2}REDACTED"
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Job-Token delete
				request>headers>X-Notification-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

{$SITE_ADDRESS} {
	import hardening
	encode zstd gzip

	# Uploads are base64 in JSON: the 10 MB file ceiling plus a third, plus room.
	request_body {
		max_size 15MB
	}

	@api path /api/* /health
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}

www.{$SITE_ADDRESS} {
	import hardening
	redir https://{$SITE_ADDRESS}{uri} permanent
}
