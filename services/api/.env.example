# Mshwar API - environment variables (names are case-insensitive).
# Copy to services/api/.env for local runs. Never commit real secrets:
# staging/production values come from the platform secret store.

# development | test | staging | production
# staging/production refuse to start with default secrets, dev endpoints or stub payments.
ENVIRONMENT=development

# Database - LOCAL ONLY
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mshwar

# Auth / security
# Signs download links. staging/production: at least 32 random characters.
SECRET_KEY=change-me-in-production
# Shared secret for cron/worker calls (header X-Job-Token): checkout ops, notification dispatch.
# staging/production: at least 32 random characters. NOTIFICATION_DISPATCH_TOKEN is still accepted.
INTERNAL_JOB_TOKEN=
# Test-only endpoints (payment simulation, fault injection). Local development only.
ENABLE_DEV_ENDPOINTS=true
# Reverse proxies in front of the API (the Next.js rewrite counts as 1).
TRUSTED_PROXY_COUNT=1
ALLOWED_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Connection pool
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_RECYCLE=1800
CONNECT_TIMEOUT=10
STATEMENT_TIMEOUT_MS=30000
# Log every SQL statement with parameters. Never in shared environments.
SQL_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# External services - LOCAL ONLY (use the platform secret store for staging/production)
GOOGLE_MAPS_API_KEY=
CATALOGUE_ROUTING_PROVIDER=auto
ROUTING_CACHE_TTL_SECONDS=21600
WEATHER_PROVIDER=stub
# AI trip builder. Empty OPENAI_API_KEY forces the deterministic stub LLM.
OPENAI_API_KEY=
PLANNER_LLM_PROVIDER=stub
PLANNER_LLM_MAX_ATTEMPTS=2
PLANNER_FAULT_INJECT=

# Payments. Without STRIPE_SECRET_KEY the adapter is a local stub that settles instantly
# (development/test only). Webhooks are rejected until STRIPE_WEBHOOK_SECRET is set.
PAYMENT_PROVIDER=stripe_test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_FAULT=
IDEMPOTENCY_TTL_HOURS=24

# Files. Local private storage when ImageKit keys are unset. Production needs a persistent path.
IMAGEKIT_API_KEY=
IMAGEKIT_URL=
PRIVATE_STORAGE_DIR=/tmp/mshwar-private
MAX_UPLOAD_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900
STAFF_INVITE_TTL_SECONDS=604800

# Email (empty = stub adapter that only logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mshwar.local
SENDGRID_API_KEY=

# Monitoring
SENTRY_DSN=
