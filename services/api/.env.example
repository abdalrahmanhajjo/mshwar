# Mshwar API - Environment Variables Template
# Copy this file to .env.local or .env.staging or .env.production
# Never commit .env files with real secrets. Secrets come from the platform secret store.

# App
NODE_ENV=development
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database - LOCAL ONLY
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mshwar
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-local-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Connection Pool
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_RECYCLE=1800
CONNECT_TIMEOUT=10
STATEMENT_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# External Services - LOCAL ONLY (use platform secret store for staging/production)
GOOGLE_MAPS_API_KEY=
CATALOGUE_ROUTING_PROVIDER=auto
ROUTING_CACHE_TTL_SECONDS=21600
WEATHER_PROVIDER=stub
OPEN_METEO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IMAGEKIT_API_KEY=
IMAGEKIT_URL=
# Local stub when ImageKit keys are unset. Verification docs stay off public URLs.
PRIVATE_STORAGE_DIR=/tmp/mshwar-private
SIGNED_URL_TTL_SECONDS=900
STAFF_INVITE_TTL_SECONDS=604800

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
POSTHOG_API_KEY=
