# App
NODE_ENV=development
ENVIRONMENT=development
# JSON array; set exact HTTPS web origins for deployed cookie-authenticated requests.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mshwar

# Redis
REDIS_URL=redis://localhost:6379/0

# API
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External Services
GOOGLE_MAPS_API_KEY=
# Browser Maps (referrer-restricted). Empty = list/pin fallback. Do not commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Catalogue search embeddings: stub (CI default) or a real provider name.
CATALOGUE_EMBEDDING_PROVIDER=stub
# auto = Google when GOOGLE_MAPS_API_KEY is set, else Haversine+road-factor stub.
# unavailable = mark travel metrics unavailable (never a silent fake estimate).
CATALOGUE_ROUTING_PROVIDER=auto
ROUTING_CACHE_TTL_SECONDS=21600
ROUTING_PLAN_BUDGET_USD=0.5
# stub = recorded fixture (CI). open-meteo = public prototype API (no SLA).
# Production: commercial Open-Meteo, Meteomatics, or self-hosted Open-Meteo — see docs/maps-routing-weather.md.
WEATHER_PROVIDER=stub
OPEN_METEO_API_KEY=
# AI trip builder. Empty OPENAI_API_KEY forces the deterministic stub LLM.
OPENAI_API_KEY=
PLANNER_LLM_PROVIDER=stub
PLANNER_LLM_MAX_ATTEMPTS=2
PLANNER_FAULT_INJECT=
# Payments (Epic 9). Empty Stripe keys keep the local stub adapter.
# Lebanon is not on Stripe's global availability page — see docs/payments.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=stripe_test
PAYMENTS_FAULT=
IDEMPOTENCY_TTL_HOURS=24
# Image uploads: leave IMAGEKIT_* empty to use the local private-storage stub.
IMAGEKIT_API_KEY=
IMAGEKIT_URL=
PRIVATE_STORAGE_DIR=/tmp/mshwar-private
SIGNED_URL_TTL_SECONDS=300

# Admin / operations (Epic 6). Scheduler stays off unless explicitly enabled.
# Cron POST /api/v1/admin/quality/run instead of a process loop in pytest/CI.
SEARCH_REINDEX_PROVIDER=stub
DATA_QUALITY_SCHEDULER_ENABLED=false
DATA_QUALITY_STALE_DAYS=14

# Notifications (Epic 10). Empty SMTP/SendGrid keys keep the stub email adapter.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mshwar.local
SENDGRID_API_KEY=
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_DISPATCH_TOKEN=
NOTIFICATION_WORKER_BATCH_SIZE=25

# Epic 13: shared production quotas; memory is a single-worker development stub.
SECURITY_RATE_BACKEND=memory
# USD micros; conservatively reserve up to 0.10 USD per planner request, including retries.
# Current planner is stub-only. Re-price this bound before adding a paid LLM adapter.
AI_DAILY_BUDGET_MICROS=5000000
AI_REQUEST_BUDGET_MICROS=100000
UPLOAD_MAX_BYTES=5242880
UPLOAD_ORG_DAILY_BYTES=104857600
UPLOAD_ORG_HOURLY_COUNT=30
# Empty DSN disables Sentry. Configured events pass through the shared scrubber.
SENTRY_DSN=
